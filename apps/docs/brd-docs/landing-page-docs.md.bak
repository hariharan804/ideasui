### 11.2 Modern Eye-Catching Smooth UI

#### Visual Hierarchy — The 3-Layer System

```
Layer 1 — Background:   #09090B  (near-black base)
Layer 2 — Surface:      #18181B  (cards, panels)
Layer 3 — Elevated:     #27272A  (hover states, active)
Accent:                 #A78BFA  (violet — CTAs, highlights, icons)
```

#### Gradient Techniques

```tsx
// Hero background glow — subtle, not distracting
<div className="absolute inset-0 overflow-hidden pointer-events-none">
  {/* Top violet glow */}
  <div className="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[400px]
    bg-violet-600/20 rounded-full blur-[120px]" />
  {/* Bottom fade */}
  <div className="absolute bottom-0 inset-x-0 h-40
    bg-gradient-to-t from-zinc-950 to-transparent" />
</div>

// Animated gradient border on feature cards (hover)
<div className="relative p-[1px] rounded-xl bg-gradient-to-br from-violet-500/30 to-transparent
  hover:from-violet-500/60 transition-all duration-300">
  <div className="rounded-xl bg-zinc-900 p-6">
    {/* card content */}
  </div>
</div>

// Section divider gradient
<div className="h-px bg-gradient-to-r from-transparent via-zinc-700 to-transparent" />
```

#### Smooth Micro-Interactions

```tsx
// Hover lift on cards
className="transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-violet-500/5"

// Smooth color transitions on links
className="text-zinc-400 hover:text-white transition-colors duration-150"

// Scale on CTA button press
className="active:scale-95 transition-transform duration-100"

// Glow on primary button hover
className="hover:shadow-lg hover:shadow-violet-500/25 transition-shadow duration-200"

// Fade-in on scroll (use Intersection Observer)
className="opacity-0 translate-y-4 animate-in fade-in slide-in-from-bottom-4 duration-500"
```

#### Tailwind Animation Config

```tsx
// tailwind.config.ts
theme: {
  extend: {
    animation: {
      "fade-in":    "fadeIn 0.5s ease-out forwards",
      "slide-up":   "slideUp 0.4s ease-out forwards",
      "glow-pulse": "glowPulse 3s ease-in-out infinite",
    },
    keyframes: {
      fadeIn:    { from: { opacity: "0" },                    to: { opacity: "1" } },
      slideUp:   { from: { opacity: "0", transform: "translateY(16px)" }, to: { opacity: "1", transform: "translateY(0)" } },
      glowPulse: { "0%,100%": { opacity: "0.4" },             "50%": { opacity: "0.8" } },
    },
  },
}
```

#### Typography Polish

```tsx
// Hero headline — tight tracking, bold weight, gradient text accent
<h1 className="text-5xl md:text-7xl font-bold tracking-tight leading-[1.1]">
  Build beautiful UIs
  <br />
  <span className="bg-gradient-to-r from-violet-400 to-violet-600 bg-clip-text text-transparent">
    with copy-paste components
  </span>
</h1>

// Section labels — uppercase spaced tracking
<p className="text-xs font-semibold uppercase tracking-widest text-violet-400 mb-3">
  Why ideasUI
</p>

// Body text — comfortable line height
<p className="text-base text-zinc-400 leading-relaxed max-w-prose">
```

