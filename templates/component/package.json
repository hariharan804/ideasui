{
  "name": "@ideasui/{{kebabCase name}}",
  "version": "0.0.0",
  "description": "{{pascalCase name}} component for IdeasUI",
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "clean-package": "../../clean-package.config.json",
  "scripts": {
    "build": "tsup src --dts",
    "dev": "pnpm build:dev --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build:dev": "tsup src",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ideasui/utils": "workspace:*",
    "@ideasui/icons": "workspace:*",
    "tailwind-variants": "^0.1.20",
    "react-aria": "^3.32.1"
  },
  "devDependencies": {
    "@ideasui/eslint-config": "workspace:*",
    "@ideasui/variants": "workspace:*",
    "@ideasui/utils": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "clean-package": "^2.2.0"
  }
}
