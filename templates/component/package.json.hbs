    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ideasui/variants": "workspace:*",
    "@ideasui/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  }
