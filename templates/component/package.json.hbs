{
  "name": "@ideasui/{{name}}",
  "version": "0.1.0",
  "description": "{{pascalCase name}} component for IdeasUI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
