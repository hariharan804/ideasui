{
  "name": "@ideasui/button",
  "version": "0.0.2-beta.1",
  "description": "A high-performance, accessible Button and ButtonGroup component library for React, built with Tailwind CSS v4 and React Aria.",
  "author": "IdeasUI<support@ideasui.com>",
  "homepage": "https://ideasui.com",
  "license": "MIT",
  "keywords": [
    "ideasui",
    "react",
    "button",
    "button-group",
    "button-component",
    "accessible-components",
    "ui-components",
    "design-system",
    "tailwindcss"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "clean-package": "../../../clean-package.config.json",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideas2logic-lab/ideasui.git",
    "directory": "packages/components/button"
  },
  "bugs": {
    "url": "https://github.com/ideas2logic-lab/ideasui/issues"
  },
  "scripts": {
    "build": "tsup --dts",
    "dev": "pnpm build:dev --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build:dev": "tsup src",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ideasui/theme": "workspace:*",
    "@ideasui/utils": "workspace:*",
    "react-aria-components": "^1.16.0"
  },
  "devDependencies": {
    "clean-package": "^2.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.3"
  }
}
