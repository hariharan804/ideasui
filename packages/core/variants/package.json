{
  "name": "@ideasui/variants",
  "version": "0.1.0",
  "description": "Tailwind CSS variants system for IdeasUI components",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsup src --dts",
    "dev": "pnpm build:dev --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build:dev": "tsup src",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "keywords": [
    "tailwind",
    "variants",
    "css",
    "design-system",
    "react",
    "typescript"
  ],
  "author": "IdeasUI<support@ideasui.com>",
  "homepage": "https://ideasui.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideas2logic-lab/ideasui.git",
    "directory": "packages/core/variants"
  },
  "bugs": {
    "url": "https://github.com/ideas2logic-lab/ideasui/issues"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  }
}
