{
  "name": "@ideasui/variants",
  "version": "0.1.0",
  "description": "Tailwind CSS variants system for IdeasUI components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "tailwind",
    "variants",
    "css",
    "design-system",
    "react",
    "typescript"
  ],
  "author": "IdeasUI Team",
  "license": "MIT",
  "dependencies": {
    "tailwind-variants": "^0.1.20",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}