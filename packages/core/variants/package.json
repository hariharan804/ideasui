{
  "name": "@ideasui/variants",
  "version": "0.1.0",
  "description": "Tailwind CSS variants system for IdeasUI components",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "tailwind",
    "variants",
    "css",
    "design-system",
    "react",
    "typescript"
  ],
  "author": "IdeasUI Team",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  }
}
