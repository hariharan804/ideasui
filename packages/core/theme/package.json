{
  "name": "@ideasui/theme",
  "version": "0.1.0",
  "description": "Tailwind CSS v4 theme system for IdeasUI",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./recipes": {
      "import": "./src/recipes/index.ts"
    },
    "./system": {
      "import": "./src/system/index.ts"
    },
    "./token": {
      "import": "./src/tokens/index.ts"
    },
    "./plugin": {
      "import": "./src/system/plugin.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "generate-theme": "node ./src/system/generator/generate-theme.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@ideasui/utils": "workspace:*",
    "@types/node": "^20.0.0",
    "chroma-js": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "tailwindcss",
    "theme",
    "design-system",
    "css",
    "ui"
  ],
  "author": "IdeasUI Team",
  "license": "MIT",
  "dependencies": {
    "color": "^5.0.3",
    "deepmerge": "^4.3.1",
    "flat": "^6.0.1",
    "tailwind-variants": "^3.2.2"
  }
}
