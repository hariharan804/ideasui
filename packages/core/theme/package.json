{
  "name": "@ideasui/theme",
  "version": "0.0.5-beta.1",
  "type": "module",
  "description": "A modern, OKLCH-based theme engine and design system plugin for Tailwind CSS v4. Features dynamic theme providers, style recipes, and custom theme storage managers.",
  "author": "IdeasUI <ideas2logic@gmail.com>",
  "homepage": "https://ideasui.com",
  "license": "MIT",
  "keywords": [
    "tailwindcss-plugin",
    "tailwind-v4",
    "theme-engine",
    "oklch",
    "design-tokens",
    "theme-provider",
    "dark-mode",
    "ideasui",
    "recipes",
    "tailwind-variants",
    "react-theme"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./recipes": {
      "types": "./src/recipes/index.ts",
      "import": "./src/recipes/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "import": "./src/tokens/index.ts"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "import": "./src/providers/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "import": "./src/plugin/index.ts"
    },
    "./dist/theme-config.css": "./dist/theme-config.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && pnpm build:theme",
    "build:theme": "node scripts/generate-theme-css.mjs && postcss dist/theme.css -o dist/theme.css && postcss dist/theme-variables.css -o dist/theme-variables.css && postcss dist/theme-config.css -o dist/theme-config.css",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "cssnano": "^7.1.3",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "color": "^5.0.3",
    "deepmerge": "^4.3.1",
    "flat": "^6.0.1",
    "tailwind-variants": "^3.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hariharan804/ideasui.git",
    "directory": "packages/core/theme"
  },
  "bugs": {
    "url": "https://github.com/hariharan804/ideasui/issues"
  }
}
