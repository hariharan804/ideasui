{
  "remove": ["devDependencies", "scripts"],
  "replace": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "style": "./dist/index.css",
    "files": ["dist"],
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "style": "./dist/index.css"
      },
      "./recipes": {
        "types": "./dist/recipes/index.d.ts",
        "import": "./dist/recipes/index.js"
      },
      "./recipes/*": "./dist/recipes/*",
      "./providers": {
        "types": "./dist/providers/index.d.ts",
        "import": "./dist/providers/index.js"
      },
      "./theme-provider": {
        "types": "./dist/providers/theme-provider.d.ts",
        "import": "./dist/providers/theme-provider.js"
      },
      "./theme-script": {
        "types": "./dist/providers/theme-script.d.ts",
        "import": "./dist/providers/theme-script.js"
      },
      "./plugin": {
        "types": "./dist/plugin/index.d.ts",
        "import": "./dist/plugin/index.js"
      },
      "./index.css": {
        "style": "./dist/index.css",
        "default": "./dist/index.css"
      },
      "./package.json": "./package.json"
    }
  }
}
