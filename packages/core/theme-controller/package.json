{
  "name": "@ideasui/theme-controller",
  "version": "1.0.0",
  "description": "SSR-friendly theme switcher with no dependencies",
  "main": "./src/index.ts",
  "files": [
    "src",
    "theme.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsup src --dts",
    "dev": "pnpm build:dev --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build:dev": "tsup src",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "theme",
    "dark-mode",
    "ssr",
    "react"
  ],
  "license": "MIT"
}
