{
  "name": "@ideasui/theme",
  "version": "1.0.0",
  "description": "SSR-friendly theme switcher with no dependencies",
  "main": "./src/index.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme-constants": "./src/theme-constants.ts",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build:css": "copyfiles theme.css dist",
    "prebuild": "pnpm run clean",
    "build": "tsup src && pnpm run build:css",
    "dev": "tsup src --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "generate-theme": "node src/theme-generate/industry-standard-shades.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "copyfiles": "^2.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "theme",
    "dark-mode",
    "ssr",
    "react"
  ],
  "license": "MIT",
  "dependencies": {
    "chroma-js": "^3.2.0"
  }
}
