{
  "name": "@ideasui/utils",
  "version": "0.0.2-beta.1",
  "description": "Shared TypeScript/React utilities and core helper functions for the IdeasUI component library, covering DOM, styles, and ARIA testing frameworks.",
  "author": "IdeasUI <ideas2logic@gmail.com>",
  "homepage": "https://ideasui.com",
  "license": "MIT",
  "keywords": [
    "typescript-utils",
    "react-utilities",
    "dom-utils",
    "aria-testing",
    "vitest-axe",
    "tailwindcss-helpers",
    "ideasui",
    "monorepo-helpers"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./aria": {
      "types": "./src/aria/index.ts",
      "import": "./src/aria/index.ts"
    },
    "./test": {
      "types": "./src/test/index.ts",
      "import": "./src/test/index.ts"
    },
    "./style": {
      "types": "./src/style/index.ts",
      "import": "./src/style/index.ts"
    }
  },
  "sideEffects": false,
  "clean-package": "./clean-package.config.json",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideas2logic-lab/ideasui.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/ideas2logic-lab/ideasui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "dev": "pnpm build:dev --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build:dev": "tsup src",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@react-types/shared": "^3.32.1",
    "clean-package": "^2.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest-axe": "^0.1.0"
  }
}
