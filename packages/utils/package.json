{
  "name": "@ideasui/utils",
  "version": "0.0.0",
  "description": "Shared utilities for IdeasUI",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./aria": "./src/aria/index.ts",
    "./dom": "./src/dom/index.ts",
    "./react": "./src/react/index.ts",
    "./shared": "./src/shared/index.ts"
  },
  "sideEffects": false,
  "clean-package": "../../clean-package.config.json",
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx --cache",
    "lint:fix": "eslint src --ext .ts,.tsx --fix --cache",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@ideasui/eslint-config": "workspace:*",
    "@ideasui/jest-config": "workspace:*",
    "@ideasui/tsconfig": "workspace:*",
    "@ideasui/tsup-config": "workspace:*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "clean-package": "^2.2.0",
    "typescript": "^5.9.3"
  }
}
