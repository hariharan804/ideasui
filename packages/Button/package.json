{
  "name": "@your-org/button",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "version": "0.1.0",
  "description": "Button component built with ShadCN/UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
