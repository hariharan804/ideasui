    "@your-org/lib": "*"
  },
  "devDependencies": {
    "@i2l/eslint-config": "*",
    "@i2l/jest-config": "*",
    "@i2l/tsup-config": "*",
    "@i2l/tsconfig": "*",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "class-variance-authority": "^0.7.1",
    "typescript": "^5.9.3"
