{
  "name": "@ideasui/root",
  "private": true,
  "version": "0.1.0",
  "description": "IdeasUI - Modern React component library built with TypeScript and Tailwind CSS",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwind"
  ],
  "author": "IdeasUI<support@ideasui.com>",
  "homepage": "https://ideasui.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideas2logic-lab/ideasui.git"
  },
  "bugs": {
    "url": "https://github.com/ideas2logic-lab/ideasui/issues"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=!@ideasui/storybook",
    "dev:playground": "turbo run dev:playground",
    "build:playground": "turbo run build:playground",
    "start:playground": "turbo run dev:playground",
    "lint": "eslint --max-warnings=0 --cache",
    "lint:fix": "eslint --max-warnings=0 --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preinstall": "node scripts/check-versions.js && npx only-allow pnpm",
    "prepare": "husky",
    "commit": "git add . && cz",
    "storybook": "turbo run dev --filter=@ideasui/storybook",
    "storybook:build": "turbo run storybook:build --filter=@ideasui/storybook --only --",
    "storybook:serve": "http-server apps/storybook/storybook-static -p 6006 -c-1 --silent",
    "storybook:kill": "lsof -ti:6006 | xargs kill -9 || true",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:visual": "pnpm run storybook:build && playwright test",
    "test:visual:ui": "playwright test --ui",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "playwright:install": "playwright install",
    "generate:packages": "node scripts/generate-package-list.js",
    "create": "plop",
    "check-naming": "node scripts/check-naming.js",
    "clean": "pnpm clean:dist && pnpm clean:test && pnpm clean:lock && pnpm clean:node-modules && pnpm install",
    "clean:dist": "rimraf ./packages/**/dist ./apps/**/dist ./packages/components/**/dist ./packages/core/**/dist ./packages/hooks/dist ./packages/icons/dist ./packages/utils/dist ./packages/cli/dist",
    "clean:node-modules": "rimraf ./apps/**/node_modules && rimraf ./packages/**/**/node_modules && rimraf ./packages/**/node_modules && rimraf ./node_modules",
    "clean:lock": "rimraf ./pnpm-lock.yaml",
    "clean:test": "jest --clearCache",
    "clean:changelogs": "rimraf ./packages/**/**/CHANGELOG.md && rimraf ./packages/**/CHANGELOG.md",
    "changeset:beta": "changeset pre enter beta",
    "version:beta": "changeset version",
    "release:beta": "changeset publish --tag beta",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "changeset:canary": "changeset pre enter canary",
    "version:canary": "changeset version --snapshot canary",
    "release:canary": "changeset publish --snapshot --no-git-tag --tag canary",
    "changeset:exit": "changeset pre exit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "workspaces": [
    "packages/components/*",
    "packages/core/*",
    "packages/utils",
    "packages/hooks",
    "packages/icons",
    "packages/cli",
    "apps/*"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.0.10",
    "@playwright/test": "^1.57.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/react": "^10.1.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.10.4",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "chromatic": "^13.3.5",
    "clean-package": "^2.2.0",
    "commitizen": "^4.3.1",
    "commitlint-plugin-function-rules": "^4.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-storybook": "10.1.4",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-testing-library": "^7.15.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-watch-select-projects": "^2.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^16.2.7",
    "plop": "^4.0.4",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.2",
    "semantic-release": "^25.0.2",
    "shell-quote": "^1.8.3",
    "size-limit": "^12.0.0",
    "storybook": "^10.1.10",
    "ts-jest": "^29.4.6",
    "tsup": "^8.3.5",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "rimraf": "^6.0.0",
      "test-exclude": "^7.0.0"
    }
  },
  "engines": {
    "pnpm": ">=8.x",
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.26.0"
}
