{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "start": {
      "cache": true,
      "persistent": true
    },
    "dev:build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": true,
      "persistent": true
    },
    "dev:playground": {
      "cache": true,
      "persistent": true
    },
    "dev:docs": {
      "cache": true,
      "persistent": true
    },
    "extract:props": {
      "outputs": ["apps/docs/lib/docs/components-props.ts"]
    },
    "build:docs": {
      "dependsOn": ["^build", "extract:props"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build:playground": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start:docs": {
      "cache": true,
      "persistent": true
    },
    "start:playground": {
      "cache": true,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    }
  }
}
