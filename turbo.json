{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "storybook:build": {
      "cache": true,
      "outputs": ["apps/storybook/storybook-static/**"]
    },
    "dev:build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": true,
      "persistent": true
    },
    "dev:playground": {
      "cache": true,
      "persistent": true
    },
    "dev:docs": {
      "cache": true,
      "persistent": true
    },
    "build:docs": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build:playground": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start:docs": {
      "cache": true,
      "persistent": true
    },
    "start:playground": {
      "cache": true,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    }
  }
}
