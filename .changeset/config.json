{
  "$schema": "https://unpkg.com/@changesets/config/schema.json",

  "changelog": [
    "@changesets/changelog-github",
    { "repo": "@ideas2logic/ideasui" }
  ],

  "commit": false,
  "access": "public",
  "baseBranch": "master",

  "updateInternalDependencies": "patch",

  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}.{timestamp}"
  }
}