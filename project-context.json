{
  "name": "ideasui-component-library",
  "description": "Modern, accessible component library built with TypeScript, Tailwind CSS, and OKLCH color system",
  "version": "0.1.0",
  "type": "monorepo",
  "framework": "react",
  "commonFeatures": {
    "accessibility": "WCAG 2.1 AA compliant",
    "theming": "Light/Dark mode with OKLCH colors",
    "typescript": "Full TypeScript support",
    "treeshaking": "Tree-shakeable exports",
    "ssr": "Server-side rendering compatible",
    "testing": "Jest + Playwright + jest-axe"
  },
  "whyShouldUseThis": {
    "modernColorSystem": "OKLCH provides perceptually uniform colors across light/dark themes",
    "accessibility": "Built-in WCAG 2.1 AA compliance with keyboard navigation and screen reader support",
    "developerExperience": "TypeScript-first with comprehensive JSDoc, recipes for consistent styling",
    "performance": "Tree-shakeable, SSR-compatible, minimal bundle size",
    "flexibility": "Tailwind Variants for easy customization without fighting the framework",
    "materialDesign": "Ripple effects and modern UI patterns out of the box"
  },
  "structure": {
    "packages": {
      "components": {
        "type": "component-library",
        "framework": "react",
        "bundler": "tsup",
        "styling": "tailwind-variants",
        "colorSystem": "oklch",
        "typescript": true,
        "exports": {
          "main": "./dist/index.js",
          "module": "./dist/index.mjs",
          "types": "./dist/index.d.ts"
        }
      },
      "core": {
        "theme": {
          "type": "design-system",
          "colorSystem": "oklch",
          "recipes": "tailwind-variants",
          "tokens": "design-tokens",
          "features": ["color-generation", "hue-locking", "dark-mode"]
        }
      },
      "hooks": {
        "type": "react-hooks",
        "framework": "react",
        "bundler": "tsup",
        "typescript": true
      },
      "utils": {
        "type": "utilities",
        "bundler": "tsup",
        "typescript": true
      },
      "icons": {
        "type": "icon-library",
        "bundler": "tsup",
        "typescript": true
      },
      "cli": {
        "type": "cli-tool",
        "bundler": "tsup",
        "typescript": true
      }
    },
    "apps": {
      "playground": {
        "type": "nextjs-app",
        "framework": "next.js",
        "version": "15+",
        "appDirectory": true,
        "purpose": "component-testing",
        "features": ["hot-reload", "component-demos", "interactive-examples"]
      },
      "storybook": {
        "type": "storybook-app",
        "framework": "storybook",
        "version": "10+",
        "purpose": "documentation",
        "features": ["component-stories", "visual-testing", "accessibility-testing"]
      }
    },
    "templates": {
      "component": {
        "type": "plop-template",
        "purpose": "component-generation",
        "includes": ["component", "hook", "tests", "stories"]
      },
      "hooks": {
        "type": "plop-template",
        "purpose": "hook-generation",
        "includes": ["hook", "tests"]
      },
      "recipe": {
        "type": "plop-template",
        "purpose": "recipe-generation",
        "includes": ["tailwind-variants"]
      },
      "rules": {
        "type": "development-guidelines",
        "purpose": "code-standards",
        "includes": [
          "naming-conventions",
          "component-development",
          "accessibility",
          "code-quality",
          "package-structure"
        ]
      }
    }
  },
  "technologies": {
    "frontend": {
      "framework": "react",
      "language": "typescript",
      "styling": "tailwindcss",
      "variants": "tailwind-variants",
      "colorSystem": "oklch",
      "stateManagement": "react-hooks"
    },
    "build": {
      "monorepo": "turborepo",
      "packageManager": "pnpm",
      "bundler": "tsup",
      "compiler": "typescript"
    },
    "development": {
      "playground": "next.js",
      "storybook": "storybook",
      "testing": "jest + playwright",
      "linting": "eslint",
      "formatting": "prettier"
    },
    "deployment": {
      "ci": "github-actions",
      "registry": "npm",
      "versioning": "changesets",
      "hosting": "vercel"
    }
  },
  "dependencies": {
    "core": {
      "react": ">=18.0.0",
      "react-dom": ">=18.0.0"
    },
    "styling": {
      "tailwindcss": ">=4",
      "tailwind-variants": ">=3.0.0",
      "clsx": "^2.0.0",
      "chroma-js": "^2.4.0"
    },
    "build": {
      "typescript": "^5.0.0",
      "tsup": "^7.0.0",
      "turbo": "^2.0.0"
    },
    "testing": {
      "jest": "^29.0.0",
      "@testing-library/react": "^14.0.0",
      "playwright": "^1.40.0",
      "jest-axe": "^8.0.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:visual": "turbo run test:visual",
    "lint": "turbo run lint",
    "storybook": "turbo run storybook",
    "playground": "pnpm --filter playground dev",
    "create": "plop",
    "generate:colors": "cd packages/core/theme && node src/system/generator/generate-theme.mjs"
  },
  "workspace": {
    "packages": [
      "packages/components/*",
      "packages/core/*",
      "packages/hooks",
      "packages/utils",
      "packages/icons",
      "packages/cli",
      "apps/*"
    ],
    "packageManager": "pnpm"
  },
  "features": {
    "componentLibrary": {
      "colorSystem": "oklch",
      "variants": "tailwind-variants",
      "theming": "light-dark-mode",
      "accessibility": "wcag-2.1-aa",
      "responsive": true,
      "treeshaking": true,
      "ssr": true,
      "rippleEffects": true
    },
    "themeSystem": {
      "colorGeneration": true,
      "hueLocking": true,
      "semanticColors": true,
      "designTokens": true,
      "recipes": true,
      "darkMode": true
    },
    "playground": {
      "liveEditing": true,
      "componentPreview": true,
      "codeExamples": true,
      "responsiveTesting": true,
      "themeToggle": true
    },
    "storybook": {
      "componentStories": true,
      "visualTesting": true,
      "accessibilityTesting": true,
      "interactiveExamples": true,
      "designTokens": true
    }
  },
  "configuration": {
    "tailwind": {
      "config": "tailwind.config.js",
      "variants": "tailwind-variants",
      "colorSystem": "oklch",
      "darkMode": "class"
    },
    "typescript": {
      "strict": true,
      "moduleResolution": "node",
      "target": "es2020"
    }
  },
  "deployment": {
    "playground": {
      "platform": "vercel",
      "domain": "playground.ideasui.com",
      "environment": "production"
    },
    "storybook": {
      "platform": "vercel",
      "domain": "storybook.ideasui.com",
      "environment": "production"
    },
    "npm": {
      "registry": "https://registry.npmjs.org/",
      "scope": "@ideasui",
      "access": "public"
    }
  }
}
